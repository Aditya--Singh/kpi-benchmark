# Copy to .env (setup.sh does this for you) and adjust. Lines starting with # are comments.

# --- Web server -------------------------------------------------------------
HOST=0.0.0.0
PORT=8077
# Long random string used to sign sessions. setup.sh fills it in.
SECRET_KEY=
SESSION_HOURS=10
# Set to true only when the app is served over HTTPS.
COOKIE_SECURE=false
# Which sites may show this app inside an iframe (the Top Management Dashboard).
# Example: 'self' https://topdashboard.pnb.internal
FRAME_ANCESTORS='self'
# Password given to the four starter users on first run. Change their passwords after signing in.
DEFAULT_PASSWORD=Pnb@12345

# --- Top Management Dashboard integration (see docs/INTEGRATION.md) -----------
# Shows a "back to dashboard" link in the top bar, and is where "Sign out" returns to.
DASHBOARD_URL=
DASHBOARD_NAME=Top Management Dashboard
# One-click sign-in from the dashboard. Leave empty to switch it off.
# Must be a long random string (32+ characters) shared ONLY with the dashboard's server.
HANDOFF_SECRET=
# Dashboard users who do not yet exist here are created as read-only viewers (true/false).
HANDOFF_AUTO_CREATE=true
# Optional: only these addresses may request sign-in tickets (comma-separated, e.g. 10.161.201.50)
HANDOFF_ALLOWED_IPS=
# How long a sign-in ticket is valid, in seconds (it can be used once).
HANDOFF_TICKET_SECONDS=120
# Analyst, approver and administrator accounts must use their own password (maker-checker). Keep false.
HANDOFF_ALLOW_STAFF=false

# --- Local language model (nothing leaves this machine) ---------------------
# ollama | openai_compatible (for vLLM) | none (template mode, no model)
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
EMBED_MODEL=nomic-embed-text
# For vLLM instead of Ollama:
# LLM_PROVIDER=openai_compatible
# OPENAI_COMPAT_URL=http://localhost:8001/v1
# OPENAI_COMPAT_MODEL=Qwen/Qwen2.5-14B-Instruct
LLM_TIMEOUT=180
# Keep false. True would allow a model endpoint on another machine.
ALLOW_REMOTE_LLM=false

# --- Data collection ----------------------------------------------------------
RESPECT_ROBOTS=true
REQUEST_DELAY_SEC=1.5
HTTP_TIMEOUT=60
# 20 quarters = 5 years of history
HISTORY_QUARTERS=20

# --- Storage --------------------------------------------------------------------
# DATA_DIR=./data
# DB_URL=sqlite:///./data/kpibench.db   (any SQLAlchemy URL, e.g. PostgreSQL, also works)
